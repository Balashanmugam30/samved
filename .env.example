# ==============================================================================
# SAMVED — Environment Configuration Template (v1.0.0-sih2026)
# Smart India Hackathon 2026 | Problem Statement 26093
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO REPOSITORY
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Runtime Settings
# ------------------------------------------------------------------------------
# APP_NAME: Service identifier in logs and telemetry
APP_NAME=samved-api
# APP_VERSION: Release version
APP_VERSION=1.0.0-sih2026
# APP_ENV: development | test | staging | production
APP_ENV=development
# APP_MODE:
#   DEV        - Safe local mock providers for offline development and UI testing
#   SIMULATION - Synthetic scenario replay through evaluation harness (Phase 14)
#   LIVE       - Production-like mode requiring live telecom and API keys
APP_MODE=DEV
# DEMO_MODE_ENABLED: Enables reproducible SIH presentation sandbox and safe reset endpoints
DEMO_MODE_ENABLED=true

# Host and port binding
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. Frontend Environment Variables (Exposed to Next.js Browser Shell)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_MODE=DEV

# ------------------------------------------------------------------------------
# 3. Logging, Tracing & Observability
# ------------------------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Structured JSON logging (automatically scrubbed of Indian PII entities)
ENABLE_STRUCTURED_JSON_LOGS=true
# Optional Sentry DSN for error telemetry
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 4. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Default Docker Compose PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/samved_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 5. Redis Cache & Distributed Session Store
# ------------------------------------------------------------------------------
# Default Docker Compose Redis connection string
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. Telephony Ingress Providers (Phase 1)
# ------------------------------------------------------------------------------
# Exotel Telephony Cloud credentials (required only in LIVE mode)
EXOTEL_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_PHONE_NUMBER=
EXOTEL_WEBHOOK_BASE_URL=http://localhost:8000
EXOTEL_STREAM_URL=ws://localhost:8000/ws/telephony/exotel
EXOTEL_VERIFY_SIGNATURE=false
EXOTEL_WEBHOOK_SECRET=

# Secondary / fallback telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 7. Speech Processing Providers (Phase 2)
# ------------------------------------------------------------------------------
# Sarvam AI for 11 Indian languages STT (Saaras:v3) and TTS (Bulbul:v3)
# (In DEV mode, high-fidelity mock speech providers are engaged automatically)
SARVAM_API_KEY=

# ------------------------------------------------------------------------------
# 8. Large Language Model (LLM) Reasoning Providers (Phase 2 & 9)
# ------------------------------------------------------------------------------
# Google Gemini conversational intelligence (gemini-2.5-flash)
GEMINI_API_KEY=
# Fallback models (optional)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 9. Security, Authentication & Governance (Phase 15)
# ------------------------------------------------------------------------------
# JWT signature secret (Minimum 32 characters; change in production)
JWT_SECRET=insecure-dev-secret-change-in-production-min-32-chars
# Allowed CORS origins for operator workstations and district dashboards
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 10. Resilience & Circuit Breaker Thresholds (Phase 16)
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0
