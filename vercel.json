{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/v1/:match*",
      "destination": { "service": "api" }
    },
    {
      "source": "/ws/:match*",
      "destination": { "service": "api" }
    },
    {
      "source": "/health:match*",
      "destination": { "service": "api" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "api" }
    },
    {
      "source": "/ready",
      "destination": { "service": "api" }
    },
    {
      "source": "/version",
      "destination": { "service": "api" }
    },
    {
      "source": "/docs:match*",
      "destination": { "service": "api" }
    },
    {
      "source": "/redoc",
      "destination": { "service": "api" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
