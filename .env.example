# ==============================================================================
# SAMVED — Environment Configuration Template
# Phase 0 Baseline Configuration
# DO NOT COMMIT REAL SECRETS TO REPOSITORY
# ==============================================================================

# Core Application Settings
# APP_ENV: development | staging | production
APP_ENV=development
# APP_MODE: DEV (safe local mock) | SIMULATION (synthetic replay) | LIVE (external providers)
APP_MODE=DEV
# Port and host configurations
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_MODE=DEV

# Logging & Observability
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Database Configuration (PostgreSQL)
# Local PostgreSQL container or development instance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samved_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Cache & Realtime Session Store
REDIS_URL=redis://localhost:6379/0

# Telephony Providers (Phase 1+)
# Set during LIVE or integration testing; optional during Phase 0 / DEV
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech Processing Providers (Phase 2+)
# Sarvam AI for Indian language STT & TTS
SARVAM_API_KEY=

# LLM Providers (Phase 2+)
# Google Gemini / OpenAI / OpenRouter
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Security & Encryption
JWT_SECRET=insecure-dev-secret-change-in-production-min-32-chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
